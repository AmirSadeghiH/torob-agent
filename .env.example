[TEMPLATE]
# All optional — the app runs with defaults and needs no API keys.
PORT=8787
# Path to the SQLite file built by `npm run data:import`
HAMKHARID_DB=data/hamkharid.db

# --- Map.ir (preferred provider: street map + routing) --------------------
# Browser-visible Map.ir key. The vector style and tiles are authenticated
# with the documented `x-api-key` request header sent by the browser, so this
# value is public by design: create it in the Map.ir panel for the map/web
# service and add domain/origin restrictions where the dashboard supports it.
VITE_MAPIR_MAP_KEY=
# Server-side Map.ir key for /route/v1/… and /vrp/tsp/v1/driving (routing,
# TSP, ETA). Never prefix it with VITE_ and never send it to the browser.
MAPIR_API_KEY=

# --- Neshan (fallback provider when Map.ir keys are absent) ---------------
# Browser-visible Web-map key. Create it in the Neshan panel as a "Web map"
# key — a *service* key is rejected by the basemap with error 483 — restrict
# it to your allowed domains (localhost:5173 for development), and expect it
# in the client bundle: it is a public map credential.
VITE_NESHAN_MAP_KEY=
# Server-only Web-service key used for /v4/direction and /v3/trip. Never
# prefix it with VITE_ and never send it to the browser.
NESHAN_API_KEY=

# --- LLM agent (optional) -------------------------------------------------
# Without these the deterministic Persian assistant answers and everything works.
AI_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Only for an OpenAI-compatible gateway; leave empty for the default endpoint.
OPENAI_BASE_URL=
# Set to false to return an error instead of the deterministic answer when the model fails.
AI_AGENT_FALLBACK_TO_RULES=true
# Hard ceiling on tool calls per turn.
AI_AGENT_MAX_STEPS=4

# Legacy alias for OPENAI_API_KEY, kept for existing local .env files.
LLM_API_KEY=
