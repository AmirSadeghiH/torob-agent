# All optional — the app runs with defaults and needs no API keys.
PORT=8787
# Path to the SQLite file built by `npm run data:import`
HAMKHARID_DB=data/hamkharid.db

# --- LLM agent (optional) -------------------------------------------------
# Without these the deterministic Persian assistant answers and everything works.
AI_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Only for an OpenAI-compatible gateway; leave empty for the default endpoint.
OPENAI_BASE_URL=
# Set to false to return an error instead of the deterministic answer when the model fails.
AI_AGENT_FALLBACK_TO_RULES=true
# Hard ceiling on tool calls per turn.
AI_AGENT_MAX_STEPS=4

# Legacy alias for OPENAI_API_KEY, kept for existing local .env files.
LLM_API_KEY=
